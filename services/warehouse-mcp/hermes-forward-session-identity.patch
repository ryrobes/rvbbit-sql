diff --git a/tests/tools/test_mcp_session_identity.py b/tests/tools/test_mcp_session_identity.py
new file mode 100644
index 000000000..70fe77510
--- /dev/null
+++ b/tests/tools/test_mcp_session_identity.py
@@ -0,0 +1,149 @@
+"""Per-turn identity forwarding for trusted first-party MCP servers."""
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+from mcp import types as mcp_types
+
+from tools import mcp_tool
+
+
+def test_forwarded_metadata_is_opt_in_and_google_chat_identity_is_verified(monkeypatch):
+    values = {
+        "HERMES_SESSION_PLATFORM": "google_chat",
+        "HERMES_SESSION_USER_ID": "Person@Example.com",
+        "HERMES_SESSION_ID": "gchat-session-1",
+    }
+    monkeypatch.setattr(
+        "gateway.session_context.get_session_env",
+        lambda name, default="": values.get(name, default),
+    )
+
+    assert mcp_tool._forwarded_session_metadata({}) is None
+    metadata = mcp_tool._forwarded_session_metadata({"forward_session_identity": True})
+    assert metadata == {
+        mcp_tool._HERMES_CALLER_META_KEY: {
+            "source": "hermes",
+            "platform": "google_chat",
+            "user_id": "person@example.com",
+            "session_id": "gchat-session-1",
+        }
+    }
+
+    values["HERMES_SESSION_PLATFORM"] = "slack"
+    assert mcp_tool._forwarded_session_metadata({"forward_session_identity": True}) is None
+
+
+def test_api_server_forwards_session_provenance_without_human_identity(monkeypatch):
+    values = {
+        "HERMES_SESSION_PLATFORM": "api_server",
+        "HERMES_SESSION_USER_ID": "untrusted@example.com",
+        "HERMES_SESSION_ID": "calliope_123",
+    }
+    monkeypatch.setattr(
+        "gateway.session_context.get_session_env",
+        lambda name, default="": values.get(name, default),
+    )
+
+    metadata = mcp_tool._forwarded_session_metadata(
+        {"forward_session_identity": True}
+    )
+
+    assert metadata == {
+        mcp_tool._HERMES_CALLER_META_KEY: {
+            "source": "hermes",
+            "platform": "api_server",
+            "session_id": "calliope_123",
+        }
+    }
+
+
+def test_cron_provenance_uses_agent_task_id_when_routing_context_is_blank(monkeypatch):
+    monkeypatch.setattr(
+        "gateway.session_context.get_session_env",
+        lambda _name, default="": default,
+    )
+
+    metadata = mcp_tool._forwarded_session_metadata(
+        {"forward_session_identity": True},
+        task_id="cron_daily-brief_20260804_090000",
+    )
+
+    assert metadata == {
+        mcp_tool._HERMES_CALLER_META_KEY: {
+            "source": "hermes",
+            "platform": "cron",
+            "session_id": "cron_daily-brief_20260804_090000",
+        }
+    }
+
+
+def test_api_server_without_a_session_does_not_emit_ambient_provenance(monkeypatch):
+    monkeypatch.setattr(
+        "gateway.session_context.get_session_env",
+        lambda name, default="": "api_server" if name == "HERMES_SESSION_PLATFORM" else default,
+    )
+
+    assert mcp_tool._forwarded_session_metadata(
+        {"forward_session_identity": True}
+    ) is None
+
+
+def test_low_level_tool_call_serializes_identity_as_mcp_meta():
+    observed = {}
+
+    class Session:
+        async def send_request(self, request, result_type):
+            observed["request"] = request.root.model_dump(by_alias=True, exclude_none=True)
+            observed["result_type"] = result_type
+            return mcp_types.CallToolResult(
+                content=[mcp_types.TextContent(type="text", text="ok")],
+                isError=False,
+            )
+
+        async def _validate_tool_result(self, name, result):
+            observed["validated"] = (name, result.isError)
+
+    metadata = {
+        mcp_tool._HERMES_CALLER_META_KEY: {
+            "source": "hermes",
+            "platform": "google_chat",
+            "user_id": "person@example.com",
+        }
+    }
+    result = asyncio.run(mcp_tool._call_tool_with_metadata(
+        Session(), "publish_dashboard", {"name": "Daily"}, metadata
+    ))
+
+    assert result.isError is False
+    assert observed["request"]["method"] == "tools/call"
+    assert observed["request"]["params"]["_meta"] == metadata
+    assert observed["request"]["params"]["arguments"] == {"name": "Daily"}
+    assert observed["result_type"] is mcp_types.CallToolResult
+    assert observed["validated"] == ("publish_dashboard", False)
+
+
+def test_failure_after_metadata_request_is_not_retried_as_a_duplicate_call():
+    observed = {"fallback_calls": 0}
+
+    class Session:
+        async def send_request(self, _request, _result_type):
+            raise RuntimeError("transport outcome unknown")
+
+        async def call_tool(self, _name, arguments=None):
+            observed["fallback_calls"] += 1
+
+    metadata = {
+        mcp_tool._HERMES_CALLER_META_KEY: {
+            "source": "hermes",
+            "platform": "google_chat",
+            "user_id": "person@example.com",
+        }
+    }
+    with pytest.raises(RuntimeError, match="outcome unknown"):
+        asyncio.run(mcp_tool._call_tool_with_metadata(
+            Session(), "publish_dashboard", {"name": "Daily"}, metadata
+        ))
+
+    assert observed["fallback_calls"] == 0
