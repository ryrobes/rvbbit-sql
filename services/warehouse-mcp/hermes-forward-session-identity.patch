+_HERMES_CALLER_META_KEY = "rvbbit.ai/hermes-caller"
+
+
+def _forwarded_session_metadata(
+    config: dict,
+    *,
+    task_id: str = "",
+    session_id: str = "",
+) -> Optional[dict]:
+    """Capture bounded provenance for one opted-in MCP request.
+
+    This runs in the agent/caller thread before the coroutine crosses onto the
+    dedicated MCP loop, because task-local gateway ContextVars intentionally do
+    not leak across that scheduling boundary. Google Chat additionally forwards
+    the adapter-verified sender email. API-server and cron requests deliberately
+    forward no human identity; their session IDs let a trusted first-party MCP
+    server correlate the request with its own durable records.
+    """
+    if not isinstance(config, dict) or config.get("forward_session_identity") is not True:
+        return None
+    try:
+        from gateway.session_context import get_session_env
+    except Exception:
+        return None
+    platform = str(get_session_env("HERMES_SESSION_PLATFORM", "") or "").strip().lower()
+    platform = platform.replace("-", "_")
+    context_session_id = str(
+        get_session_env("HERMES_SESSION_ID", "") or session_id or task_id or ""
+    ).strip()[:240]
+    if not platform and context_session_id.startswith("cron_"):
+        platform = "cron"
+    if platform == "gchat":
+        platform = "google_chat"
+    if platform not in {"google_chat", "api_server", "cron"}:
+        return None
+    envelope = {
+        "source": "hermes",
+        "platform": platform,
+    }
+    if context_session_id:
+        envelope["session_id"] = context_session_id
+    elif platform != "google_chat":
+        # A platform label alone cannot correlate an API/automation request and
+        # would turn every unscoped Hermes call into low-value telemetry.
+        return None
+    if platform == "google_chat":
+        user_id = str(get_session_env("HERMES_SESSION_USER_ID", "") or "").strip().lower()
+        if not user_id or len(user_id) > 254 or "@" not in user_id:
+            return None
+        envelope["user_id"] = user_id
+    return {_HERMES_CALLER_META_KEY: envelope}
+
+
+async def _call_tool_with_metadata(session, name: str, arguments: dict, metadata: Optional[dict]):
+    """Call a tool with MCP ``_meta`` while retaining SDK result validation."""
+    if not metadata:
+        return await session.call_tool(name, arguments=arguments)
+    try:
+        from mcp import types as mcp_types
+
+        params = mcp_types.CallToolRequestParams(
+            name=name,
+            arguments=arguments,
+            **{"_meta": metadata},
+        )
+        request = mcp_types.ClientRequest(
+            mcp_types.CallToolRequest(method="tools/call", params=params)
+        )
+    except (AttributeError, ImportError, TypeError) as exc:
+        # Older optional MCP SDKs may not expose the low-level request types.
+        # Preserve tool availability, but make the attribution downgrade
+        # visible to operators rather than failing the user's request.
+        logger.warning("MCP session identity metadata unavailable: %s", exc)
+        return await session.call_tool(name, arguments=arguments)
+    send_request = getattr(session, "send_request", None)
+    if not callable(send_request):
+        logger.warning("MCP session identity metadata unavailable: client has no send_request")
+        return await session.call_tool(name, arguments=arguments)
+    # Do not catch failures after the request is sent: retrying through
+    # call_tool here could duplicate a successful mutating server operation.
+    result = await send_request(request, mcp_types.CallToolResult)
+    validate = getattr(session, "_validate_tool_result", None)
+    if not result.isError and callable(validate):
+        await validate(name, result)
+    return result
+
