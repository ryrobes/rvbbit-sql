# Runtime contract for docker/docker-compose.calliope.yml.
# The provisioner writes the real file to /opt/rvbbit/.env with mode 0600.
# Never commit a populated copy.

# Operator-owned Clover credential. This is the only inference credential a
# hosted customer appliance needs; it is consumed by Postgres, Hermes, the
# isolated Hindsight service, and Warehouse's uncapped spoken-response rewrite.
RVBBIT_CLOVER_KEY=
RVBBIT_CLOVER_OPENAI_BASE_URL=https://clover.rvbb.it/v1
RVBBIT_CLOVER_REQUIRED_MODEL=calliope

# Explicit product image pins supplied by the appliance release manifest.
RVBBIT_POSTGRES_IMAGE=
RVBBIT_LENS_IMAGE=
RVBBIT_WARREN_AGENT_IMAGE=
RVBBIT_WAREHOUSE_MCP_IMAGE=
RVBBIT_DOC_EXTRACT_IMAGE=
RVBBIT_ORIGIN_IMAGE=caddy:2.10.2-alpine

# Generated independently by the provisioner. Use long random values and do
# not reuse the Clover key, a database password, or one another.
POSTGRES_PASSWORD=
RVBBIT_CREDENTIAL_KEY=
RVBBIT_GATEWAY_TOKEN=
RVBBIT_MIRROR_TOKEN=
WAREHOUSE_JWT_SECRET=
WAREHOUSE_MCP_KEY=
WAREHOUSE_HERMES_API_KEY=
WAREHOUSE_HERMES_MCP_KEY=

# Initial exact one-email administrator boundary. Google sign-in can replace
# this later without blocking first boot.
WAREHOUSE_LOGIN_PASSWORD=
WAREHOUSE_ALLOWED_EMAILS=admin@example.com
WAREHOUSE_TEAM_BOOTSTRAP_ADMINS=admin@example.com
WAREHOUSE_HERMES_MEMORY_KEY=company

# Optional spoken Calliope responses. Both values are required to enable the
# server-side ElevenLabs stream; the semantic script rewrite still uses Clover.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Public routing is normally filled by deployment after DNS/TLS exists.
WAREHOUSE_PUBLIC_URL=
LENS_PUBLIC_URL=
RVBBIT_ORIGIN_PORT=8080
# Advanced DataRabbit/Burrow diagnostic entrypoint. Keep loopback-only and use
# an SSH tunnel unless the deployment's TLS proxy deliberately exposes it.
RVBBIT_BURROW_PORT=127.0.0.1:3001
# The raw Lens listener is not a complete auth origin; keep it local as well.
RVBBIT_LENS_PORT=127.0.0.1:3000
WAREHOUSE_CALLIOPE_EXPORT_DIR=/opt/rvbbit/calliope-exports
# Container-local allowlist for explicit server-folder Company Brain imports.
# `brain_crawl_folder` rejects `/` and anything outside these roots.
WAREHOUSE_BRAIN_IMPORT_ROOTS=/app/data/brain-imports

# Hosted invariants.
RVBBIT_REQUIRE_CANONICAL_CREDENTIALS=true
RVBBIT_MODE=burrow
WAREHOUSE_AUTH=shared
WAREHOUSE_LOGIN_UI=lens
WAREHOUSE_CALLIOPE_STT_PROVIDER=off
